# ─────────────────────────────────────────────
# 🌐 Environment
# ─────────────────────────────────────────────
ENV=local                # local | dev | stg | prod
LOG_LEVEL=DEBUG           # DEBUG | INFO | WARNING | ERROR

# ─────────────────────────────────────────────
# 🤖 LLM Provider (OpenAI / Gemini / Claude / Azure / Ollama)
# ─────────────────────────────────────────────
LLM_PROVIDER=openai      # default provider

# OpenAI
OPENAI_API_KEY=sk-proj-xxxx
OPENAI_MODEL=gpt-4.1-mini

# Google Gemini
GOOGLE_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Ollama (로컬 모델)
OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────────
# 📡 LangSmith (Tracing / Monitoring)
# ─────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxxxx
LANGSMITH_PROJECT=agent-foundation
LANGSMITH_ENDPOINT=

# ─────────────────────────────────────────────
# 🧠 Memory Backend (inmemory | redis)
# ─────────────────────────────────────────────
MEMORY_BACKEND=inmemory
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
# 🔍 VectorStore (chroma | pgvector | inmemory)
# ─────────────────────────────────────────────
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./.chroma

# pgvector (옵션)
PGVECTOR_CONNECTION_URL=postgresql://user:pass@localhost:5432/vector_db

# ─────────────────────────────────────────────
# 📚 RAG 설정
# ─────────────────────────────────────────────
RAG_DOCS_DIR=./data/docs
RAG_IMAGES_DIR=./data/images
RAG_API_BASE_URL=https://example.com/api

# (옵션) RAG 인덱싱 설정
RAG_MAX_CHUNK_SIZE=800
RAG_MAX_CHUNKS=5

# ─────────────────────────────────────────────
# 🌐 API 서버 설정 (옵션)
# ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
